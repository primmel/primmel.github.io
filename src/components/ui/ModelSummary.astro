---
import type { ModelStats } from '../../lib/model-parser';

interface StatDescriptor {
  key: keyof ModelStats;
  label: string;
  always?: boolean;
}

const STAT_DESCRIPTORS: StatDescriptor[] = [
  { key: 'roles', label: 'roles', always: true },
  { key: 'processes', label: 'processes', always: true },
  { key: 'provisions', label: 'provisions' },
  { key: 'dataClasses', label: 'data classes' },
  { key: 'registries', label: 'registries' },
  { key: 'events', label: 'events' },
  { key: 'gateways', label: 'gateways' },
  { key: 'measurements', label: 'measurements' },
  { key: 'references', label: 'references' },
  { key: 'approvals', label: 'approvals' },
  { key: 'enums', label: 'enums' },
  { key: 'subprocesses', label: 'subprocesses' },
  { key: 'forms', label: 'forms' },
  { key: 'subforms', label: 'subforms' },
  { key: 'symbols', label: 'symbols' },
  { key: 'calculations', label: 'calculations' },
  { key: 'stateMachines', label: 'state machines' },
  { key: 'terms', label: 'terms' },
  { key: 'mapProfiles', label: 'map profiles' },
  { key: 'viewProfiles', label: 'view profiles' },
  { key: 'tables', label: 'tables' },
  { key: 'figures', label: 'figures' },
  { key: 'notes', label: 'notes' },
  { key: 'links', label: 'links' },
];

interface Props {
  stats: ModelStats | null;
}
const { stats } = Astro.props;
const visibleStats = stats
  ? STAT_DESCRIPTORS.filter(d => d.always || (stats[d.key] as number) > 0)
  : [];
---

{stats && (
  <div class="model-summary">
    <h4>Model summary</h4>
    <div class="stats-grid">
      {visibleStats.map(d => (
        <div class="stat">
          <span class="stat-num">{stats[d.key]}</span>
          <span class="stat-label">{d.label}</span>
        </div>
      ))}
    </div>
    <dl class="model-meta">
      <dt>root</dt><dd><code>{stats.root}</code></dd>
      <dt>namespace</dt><dd><code>{stats.namespace}</code></dd>
    </dl>
  </div>
)}

<style>
  .model-summary {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
  }
  h4 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--color-burgundy);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  :global(.dark) h4 { color: var(--color-ochre); }
  .stats-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: baseline;
    gap: 0.15rem;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-3);
  }
  .model-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    font-size: 0.82rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }
  dt { color: var(--color-text-3); font-weight: 500; }
  dd { margin: 0; }
  dd code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: var(--color-surface-2);
    border: 1px solid var(--color-rule);
    padding: 0.05em 0.35em;
    border-radius: 3px;
    color: var(--color-burgundy);
  }
  :global(.dark) dd code { color: var(--color-ochre); }
</style>

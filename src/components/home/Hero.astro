---
---

<section class="hero">
  <div class="hero-left">
    <p class="eyebrow">Executable standards modelling</p>

    <h1>Standards are<br /><em>programs</em>, not PDFs.</h1>

    <p class="tagline">
      Primmel turns ISO, BSI, and OIML standards into typed, machine-readable
      <strong>runnable models</strong>. Process flows, data requirements,
      and evidence — in one plain-text <code>.prl</code> file.
    </p>

    <div class="actions">
      <a href="/docs/first-model" class="btn-primary">Get started →</a>
      <a href="/examples/" class="btn-secondary">See examples</a>
    </div>

    <div class="social-proof">
      <span>Developed with</span>
      <strong>BSI</strong>
      <span>·</span>
      <strong>OIML SMART</strong>
      <span>·</span>
      <a href="/about">Ribose</a>
    </div>
  </div>

  <div class="hero-right">
    <div class="code-window">
      <div class="code-header">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
        <span class="code-filename">hello-world.prl</span>
      </div>
      <pre class="code-body"><code><span class="tok-kw">root</span> HelloWorld
<span class="tok-kw">metadata</span> &#123;
  <span class="tok-prop">title</span> <span class="tok-str">"Hello World"</span>
  <span class="tok-prop">namespace</span> <span class="tok-str">"HelloWorld"</span>
&#125;

<span class="tok-kw">role</span> Greeter &#123; <span class="tok-prop">name</span> <span class="tok-str">"Greeter"</span> &#125;

<span class="tok-kw">start_event</span> Start &#123; &#125;
<span class="tok-kw">end_event</span> Done &#123; &#125;

<span class="tok-kw">process</span> Greet &#123;
  <span class="tok-prop">name</span> <span class="tok-str">"Greet the world"</span>
  <span class="tok-prop">actor</span> Greeter
&#125;

<span class="tok-kw">subprocess</span> Root &#123;
  <span class="tok-kw">elements</span> &#123;
    Start &#123; <span class="tok-prop">x</span> 0 <span class="tok-prop">y</span> 0 &#125;
    Greet &#123; <span class="tok-prop">x</span> 0 <span class="tok-prop">y</span> 100 &#125;
    Done  &#123; <span class="tok-prop">x</span> 0 <span class="tok-prop">y</span> 200 &#125;
  &#125;
  <span class="tok-kw">process_flow</span> &#123;
    E1 &#123; <span class="tok-kw">from</span> Start <span class="tok-kw">to</span> Greet &#125;
    E2 &#123; <span class="tok-kw">from</span> Greet <span class="tok-kw">to</span> Done &#125;
  &#125;
&#125;</code></pre>
    </div>

    <div class="hero-diagram-mini">
      <img src="/primmel-logo-light.svg" class="logo-mini light-only" alt="" width="24" height="24" />
      <img src="/primmel-logo-dark.svg" class="logo-mini dark-only" alt="" width="24" height="24" />
      <span class="diagram-label">One model. Five pillars. Full lifecycle.</span>
      <a href="/architecture/" class="diagram-link">Understand the architecture →</a>
    </div>
  </div>
</section>

<style>
  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-burgundy);
    margin-bottom: 1.25rem;
  }
  :global(.dark) .eyebrow { color: var(--color-ochre); }
  h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0 0 1.25rem;
  }
  h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-indigo);
  }
  .tagline {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-2);
    max-width: 480px;
    margin: 0 0 1.75rem;
  }
  .tagline strong { font-weight: 600; color: var(--color-ink); }
  .tagline code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--color-surface-2);
    border: 1px solid var(--color-rule);
    padding: 0.05em 0.35em;
    border-radius: 3px;
    color: var(--color-burgundy);
  }
  :global(.dark) .tagline code { color: var(--color-ochre); }
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .btn-primary {
    padding: 0.6rem 1.3rem;
    border-radius: 6px;
    background: var(--color-indigo);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    transition: background var(--dur-fast) ease;
  }
  .btn-primary:hover { background: var(--color-indigo-mid); }
  .btn-secondary {
    padding: 0.6rem 1.3rem;
    border-radius: 6px;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--dur-fast) ease;
  }
  .btn-secondary:hover { border-color: var(--color-ink); }
  .social-proof {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-3);
  }
  .social-proof strong { color: var(--color-text-2); font-weight: 600; }
  .social-proof a { color: var(--color-indigo); text-decoration: none; }
  .social-proof a:hover { text-decoration: underline; }

  /* Code window */
  .code-window {
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.85rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-rule);
  }
  .dot {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }
  .code-filename {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-3);
  }
  .code-body {
    margin: 0;
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.75;
    overflow-x: auto;
    background: var(--color-surface) !important;
    border: none;
    border-radius: 0;
  }
  .tok-kw { color: var(--color-burgundy); font-weight: 500; }
  :global(.dark) .tok-kw { color: var(--color-ochre); }
  .tok-prop { color: var(--color-indigo); }
  :global(.dark) .tok-prop { color: var(--color-indigo-mid); }
  .tok-str { color: var(--color-olive); }

  /* Mini diagram link */
  .hero-diagram-mini {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
  }
  .logo-mini { width: 24px; height: 24px; }
  .diagram-label {
    font-size: 0.82rem;
    color: var(--color-text-2);
    font-weight: 500;
  }
  .diagram-link {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--color-indigo);
    text-decoration: none;
    white-space: nowrap;
  }
  .diagram-link:hover { text-decoration: underline; }

  .light-only { display: inline; }
  .dark-only { display: none; }
  :global(.dark) .light-only { display: none; }
  :global(.dark) .dark-only { display: inline; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding: 2.5rem 1.5rem 1.5rem; }
    .hero-right { order: -1; }
    .code-body { font-size: 0.72rem; }
  }
</style>

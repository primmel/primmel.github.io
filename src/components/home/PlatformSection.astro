---
// The platform in one section (TODO.ops/27): the Primmel SMART
// platform shown as its component technologies — cards, not rungs —
// plus the programs built on it, each with one link out.
const components = [
  {
    name: 'Primmel',
    detail: 'the typed, executable modelling language (IS–HAS–DOES) — models that run',
    href: '/docs/introduction',
  },
  {
    name: 'The platform machinery',
    detail: 'the methodology, the Studio, the app/runtime framework, the compliance engine, the twin runtime',
    href: '/architecture/platform',
  },
  {
    name: 'Primmel SST',
    detail: 'the simulated-SMART-twin framework — instruments honest enough to certify against',
    href: '/sst',
  },
  {
    name: 'Confium',
    detail: "the threshold-cryptography PKI the platform's certificates ride",
    href: '/confium',
  },
];

const programs = [
  {
    name: 'OIML SMART',
    detail: "the first program — the OIML's legal-metrology certification system, end to end",
    href: 'https://www.oimlsmart.org/',
    external: true,
  },
  {
    name: '〈scope〉 SMART',
    detail: 'the open slots — accreditation, MSS certification, laboratory programs (zero forks)',
    href: '/programs/',
  },
];
---

<section class="platform-section" aria-label="The Primmel SMART platform">
  <h2>The Primmel SMART platform</h2>
  <p class="platform-intro">
    One language, one platform. The platform is its component
    technologies — each real today — and each program built on it is a
    full SMART program in its own right, on its own site.
  </p>

  <h3>The components</h3>
  <ul class="component-grid">
    {components.map((c) => (
      <li class="component-card">
        <a href={c.href} class="component-name">{c.name}</a>
        <p class="component-detail">{c.detail}</p>
      </li>
    ))}
  </ul>

  <h3>The programs</h3>
  <ul class="program-list">
    {programs.map((p) => (
      <li class="program-row">
        <a href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})} class="program-name">
          {p.name}
        </a>
        <span class="program-detail">{p.detail}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .platform-section {
    margin: 3rem auto 0;
    max-width: 56rem;
  }
  .platform-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .platform-intro {
    color: var(--color-text-2);
    margin-bottom: 1.5rem;
  }
  .platform-section h3 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-burgundy);
    margin: 1.75rem 0 0.75rem;
  }
  :global(.dark) .platform-section h3 { color: var(--color-ochre); }
  .component-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  .component-card {
    border: 1px solid var(--color-rule);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
    background: var(--color-surface);
    transition: border-color var(--dur-fast) ease;
  }
  .component-card:hover {
    border-color: var(--color-indigo);
  }
  .component-name {
    font-weight: 700;
    color: var(--color-indigo);
    text-decoration: none;
  }
  .component-name:hover {
    text-decoration: underline;
  }
  .component-detail {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--color-text-2);
  }
  .program-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .program-row {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    border: 1px solid var(--color-rule);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
  }
  .program-name {
    font-weight: 700;
    color: var(--color-indigo);
    text-decoration: none;
    white-space: nowrap;
  }
  .program-name:hover {
    text-decoration: underline;
  }
  .program-detail {
    font-size: 0.875rem;
    color: var(--color-text-2);
  }
  @media (max-width: 640px) {
    .program-row { flex-direction: column; gap: 0.25rem; }
  }
</style>

---
import { FEATURES } from '../../consts';
import type { PillarInfo } from '../../lib/navigation';

interface Props {
  pillars: PillarInfo[];
}
const { pillars } = Astro.props;
---

<!-- Problem / Solution -->
<section class="compare">
  <div class="compare-grid">
    <div class="compare-col compare-before">
      <p class="compare-label">Today</p>
      <h3>Standards as documents</h3>
      <ul>
        <li>PDFs that humans must read and interpret manually</li>
        <li>Compliance checked by hand, slow, error-prone, subjective</li>
        <li>Evidence scattered across systems, hard to trace</li>
        <li>Updates require re-distributing hundreds of pages</li>
      </ul>
    </div>
    <div class="compare-col compare-after">
      <p class="compare-label">With Primmel</p>
      <h3>Standards as programs</h3>
      <ul>
        <li>Typed <code>.prl</code> models a computer can parse and run</li>
        <li>Process flows execute, automatic, deterministic, repeatable</li>
        <li>Evidence built in, every requirement carries hooks</li>
        <li>One source file: update once, everyone sees the change</li>
      </ul>
    </div>
  </div>
</section>

<!-- Pillars -->
<section class="section">
  <p class="eyebrow">Architecture</p>
  <h2 class="section-title">Five pillars, one lifecycle.</h2>
  <p class="section-desc">
    From the moment a reference model is published to the moment an
    auditor hands down a verdict, each pillar has a distinct actor
    and a distinct artifact.
  </p>
  <nav class="pillars-grid">
    {pillars.map(p => (
      <a href={p.href} class="pillar-card">
        <span class="num">{p.num}</span>
        <span class="name">{p.name}</span>
        <span class="desc">{p.desc}</span>
      </a>
    ))}
  </nav>
</section>

<!-- Features as cards -->
<section class="section">
  <p class="eyebrow">Why Primmel</p>
  <h2 class="section-title">Built for the work standards actually do.</h2>
  <div class="features-grid">
    {FEATURES.map(f => (
      <article class="feature-card">
        <span class="feature-num">{f.num}</span>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </article>
    ))}
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="cta-inner">
    <h2>Start modelling your standard in minutes.</h2>
    <p>Read the introduction, then build your first <code>.prl</code> model.</p>
    <div class="cta-actions">
      <a href="/docs/first-model" class="btn-primary">Get started →</a>
      <a href="/examples/" class="btn-secondary">Browse examples</a>
    </div>
  </div>
</section>

<style>
  /* Problem / Solution */
  .compare {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }
  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .compare-col {
    border-radius: 8px;
    padding: 2rem;
  }
  .compare-before {
    background: var(--color-surface-2);
    border: 1px solid var(--color-rule);
  }
  .compare-after {
    background: var(--color-surface);
    border: 1px solid var(--color-indigo);
  }
  .compare-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }
  .compare-before .compare-label { color: var(--color-text-3); }
  .compare-after .compare-label { color: var(--color-indigo); }
  .compare-col h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .compare-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .compare-col li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-2);
    padding: 0.4rem 0;
    padding-left: 1.25rem;
    position: relative;
  }
  .compare-col li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-text-3);
  }
  .compare-after li::before { color: var(--color-indigo); }
  .compare-col code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface-2);
    padding: 0.05em 0.35em;
    border-radius: 3px;
    color: var(--color-burgundy);
  }
  @media (max-width: 768px) {
    .compare-grid { grid-template-columns: 1fr; }
  }

  /* Sections */
  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
    border-top: 1px solid var(--color-rule);
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-burgundy);
    margin-bottom: 1.25rem;
  }
  :global(.dark) .eyebrow { color: var(--color-ochre); }
  .section-title {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 600;
    margin: 0 0 1rem;
    max-width: 680px;
  }
  .section-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-2);
    max-width: 600px;
    margin: 0 0 2.5rem;
  }

  /* Pillars as cards */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-fast) ease, transform var(--dur-fast) ease;
  }
  .pillar-card:hover {
    border-color: var(--color-indigo);
    transform: translateY(-2px);
  }
  .pillar-card .num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-burgundy);
    font-weight: 600;
  }
  :global(.dark) .pillar-card .num { color: var(--color-ochre); }
  .pillar-card .name {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .pillar-card .desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-text-2);
  }

  /* Features as cards */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
  .feature-card {
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }
  .feature-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-burgundy);
    font-weight: 600;
    display: block;
    margin-bottom: 0.5rem;
  }
  :global(.dark) .feature-num { color: var(--color-ochre); }
  .feature-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }
  .feature-card p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-2);
    margin: 0;
  }

  /* CTA */
  .cta-section {
    border-top: 1px solid var(--color-rule);
    padding: 4rem 2rem 5rem;
    text-align: center;
  }
  .cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .cta-section h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .cta-section p {
    font-size: 1rem;
    color: var(--color-text-2);
    margin: 0 0 1.75rem;
  }
  .cta-section code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--color-surface-2);
    padding: 0.05em 0.35em;
    border-radius: 3px;
  }
  .cta-actions {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    padding: 0.6rem 1.3rem;
    border-radius: 6px;
    background: var(--color-indigo);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    transition: background var(--dur-fast) ease;
  }
  .btn-primary:hover { background: var(--color-indigo-mid); }
  .btn-secondary {
    padding: 0.6rem 1.3rem;
    border-radius: 6px;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--dur-fast) ease;
  }
  .btn-secondary:hover { border-color: var(--color-ink); }
</style>

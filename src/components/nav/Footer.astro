<footer class="footer">
  <div class="footer-container">
    <p class="footer-message">An open source project of <a href="https://www.ribose.com">Ribose</a></p>
    <p class="footer-copyright">Copyright © {new Date().getFullYear()} Ribose</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-rule);
    background: var(--color-cream);
  }
  .footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }
  .footer-message a {
    color: var(--color-indigo);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 2px;
  }
  .footer-copyright { color: var(--color-text-3); }
  @media (max-width: 768px) {
    .footer-container { flex-direction: column; gap: 0.5rem; text-align: center; }
  }
</style>
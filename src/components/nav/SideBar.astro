---
import type { NavGroup } from '../../lib/navigation';

interface Props {
  groups: NavGroup[];
  activeHref: string;
}
const { groups, activeHref } = Astro.props;
---

<aside class="sidebar">
  {groups.map(group => (
    <section class="sidebar-group">
      <h2 class="sidebar-heading">{group.section}</h2>
      <ul>
        {group.items.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['sidebar-link', { 'is-active': item.href === activeHref || item.href + '/' === activeHref }]} aria-current={item.href === activeHref || item.href + '/' === activeHref ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</aside>

<style>
  .sidebar {
    padding: 2rem 0;
    border-right: 1px solid var(--c-rule);
    font-family: var(--font-body);
  }
  .sidebar-group { margin-bottom: 0.5rem; }
  .sidebar-heading {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-burgundy);
    padding: 0 1rem;
    margin: 1.75rem 0 0.5rem;
  }
  :global(.dark) .sidebar-heading { color: var(--c-ochre); }
  .sidebar ul { list-style: none; padding: 0; margin: 0; }
  .sidebar-link {
    display: block;
    padding: 0.3rem 1rem;
    font-size: 0.88rem;
    color: var(--c-text-2);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .sidebar-link:hover { color: var(--c-ink); }
  .sidebar-link.is-active {
    color: var(--c-indigo);
    font-weight: 500;
    border-left-color: var(--c-burgundy);
  }
  :global(.dark) .sidebar-link.is-active { color: var(--c-indigo); }
</style>
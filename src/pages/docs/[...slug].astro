---
import { COLLECTIONS } from '../../lib/collections';
import { getCollectionSlugs, renderEntry } from '../../lib/page-helpers';
import DocLayout from '../../layouts/DocLayout.astro';

export async function getStaticPaths() {
  return getCollectionSlugs(COLLECTIONS.docs);
}

const { entry } = Astro.props;
const { Content, headings, readingTime } = await renderEntry(entry);
---

<DocLayout title={entry.data.title} collection={COLLECTIONS.docs} slug={entry.id} headings={headings}
  readingTime={readingTime}>
  <Content />
</DocLayout>

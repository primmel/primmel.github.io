---
import { render } from 'astro:content';
import { COLLECTIONS } from '../../lib/collections';
import { getCollectionSlugs, computeReadingTime } from '../../lib/page-helpers';
import DocLayout from '../../layouts/DocLayout.astro';

export async function getStaticPaths() {
  return getCollectionSlugs(COLLECTIONS.docs);
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingTime = computeReadingTime(entry.body);
---

<DocLayout title={entry.data.title} collection={COLLECTIONS.docs} slug={entry.id} headings={headings}
  readingTime={readingTime}>
  <Content />
</DocLayout>

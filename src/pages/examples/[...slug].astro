---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('examples');
  return entries.map(entry => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  })).filter(p => p.params.slug !== undefined);
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout title={entry.data.title} collection="examples" slug={entry.id} headings={headings}>
  <Content />
</DocLayout>
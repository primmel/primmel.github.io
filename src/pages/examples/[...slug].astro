---
import { render } from 'astro:content';
import { COLLECTIONS } from '../../lib/collections';
import { getCollectionSlugs } from '../../lib/navigation';
import { parseModel } from '../../lib/model-parser';
import { estimateReadingTime } from '../../lib/reading-time';
import DocLayout from '../../layouts/DocLayout.astro';
import ModelSummary from '../../components/ui/ModelSummary.astro';
import ProcessFlowDiagram from '../../components/diagrams/ProcessFlowDiagram.astro';
import ModelBrowserVue from '../../components/ui/ModelBrowser.vue';

export async function getStaticPaths() {
  return getCollectionSlugs(COLLECTIONS.examples);
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingTime = entry.body ? estimateReadingTime(entry.body) : undefined;
const data = entry.data as { title: string; sourceFile?: string };
const parsed = data.sourceFile ? parseModel(data.sourceFile) : null;
---

<DocLayout title={data.title} collection={COLLECTIONS.examples} slug={entry.id} headings={headings}
  readingTime={readingTime}>
  {parsed && <ModelSummary stats={parsed.stats} />}
  {parsed && parsed.flows.length > 0 && (
    <section class="process-flows">
      {parsed.flows.map(flow => <ProcessFlowDiagram flow={flow} />)}
    </section>
  )}
  <Content />
  {parsed && (
    <section class="model-browser-section">
      <h2 id="model-elements">Model elements</h2>
      <ModelBrowserVue client:visible tree={parsed.tree} />
    </section>
  )}
</DocLayout>

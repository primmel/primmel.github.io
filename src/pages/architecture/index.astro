---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';

const entries = await getCollection('architecture');
const entry = entries.find(e => e.id === 'index');
if (!entry) {
  throw new Error('architecture/index.md not found');
}
const { Content, headings } = await render(entry);
---

<DocLayout title={entry.data.title} collection="architecture" slug="index" headings={headings}>
  <Content />
</DocLayout>
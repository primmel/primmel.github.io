---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="404" description="Page not found.">
  <div class="not-found">
    <p class="nf-eyebrow">Page not found</p>
    <h1>4<em>0</em>4</h1>
    <p>
      The page you were looking for is not in this model. It may have
      been moved, renamed, or removed — or it never existed in the
      first place.
    </p>
    <div class="nf-actions">
      <a href="/" class="btn-brand">Return home</a>
      <a href="/docs/introduction" class="btn-alt">Read the introduction</a>
    </div>
  </div>
</PageLayout>

<style>
  .not-found {
    max-width: 760px;
    margin: 0 auto;
    padding: 6rem 2rem;
  }
  .nf-eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-burgundy);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
    margin: 0 0 1.5rem;
  }
  h1 em { font-style: italic; color: var(--c-indigo); font-weight: 300; }
  p { font-size: 1.1rem; color: var(--c-text-2); margin: 0 0 2rem; max-width: 540px; }
  .nf-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .btn-brand {
    padding: 0.55rem 1.15rem;
    border-radius: 4px;
    background: var(--c-ink);
    color: var(--c-surface);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--c-ink);
  }
  .btn-alt {
    padding: 0.55rem 1.15rem;
    border-radius: 4px;
    border: 1px solid var(--c-rule-strong);
    color: var(--c-ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }
</style>
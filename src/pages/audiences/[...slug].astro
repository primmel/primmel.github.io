---
import { render } from 'astro:content';
import { COLLECTIONS } from '../../lib/collections';
import { getCollectionSlugs } from '../../lib/navigation';
import { estimateReadingTime } from '../../lib/reading-time';
import DocLayout from '../../layouts/DocLayout.astro';

export async function getStaticPaths() {
  return getCollectionSlugs(COLLECTIONS.audiences);
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingTime = entry.body ? estimateReadingTime(entry.body) : undefined;
---

<DocLayout title={entry.data.title} collection={COLLECTIONS.audiences} slug={entry.id} headings={headings}
  readingTime={readingTime}>
  <Content />
</DocLayout>

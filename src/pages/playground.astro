---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Playground" description="Try Primmel in your browser — edit a model and see it parse live." wide>
  <div id="playground-root"></div>
</PageLayout>

<script type="module">
  import { load, dump } from '@primmel/primmel';

  const root = document.getElementById('playground-root');
  if (!root) throw new Error('no playground root');

  const sampleModel = `root HelloWorld

version "v1.0.0-dev1"

metadata {
  title "Hello World"
  schema "Primmel 0.1"
  namespace "HelloWorld"
}

role Greeter { name "Greeter" }

start_event Start { }
end_event Done { }

process Greet {
  name "Greet the world"
  actor Greeter
}

canvas Root {
  elements {
    Start { x 0 y 0 }
    Greet { x 0 y 100 }
    Done  { x 0 y 200 }
  }
  process_flow {
    E1 { from Start to Greet }
    E2 { from Greet to Done }
  }
}`;

  // Build the UI
  root.innerHTML = `
    <div class="pg-layout">
      <div class="pg-editor">
        <div class="pg-editor-header">
          <span>hello-world.prl</span>
          <button id="pg-format" class="pg-btn">Format</button>
          <button id="pg-download" class="pg-btn">Download</button>
        </div>
        <textarea id="pg-code" spellcheck="false" class="pg-code"></textarea>
      </div>
      <div class="pg-output">
        <div id="pg-error" class="pg-error" style="display:none"></div>
        <div id="pg-stats" class="pg-stats"></div>
        <div id="pg-tree" class="pg-tree"></div>
      </div>
    </div>
  `;

  const codeEl = document.getElementById('pg-code');
  const errorEl = document.getElementById('pg-error');
  const statsEl = document.getElementById('pg-stats');
  const treeEl = document.getElementById('pg-tree');

  codeEl.value = sampleModel;

  function parse() {
    const code = codeEl.value;
    try {
      const model = load(code);
      errorEl.style.display = 'none';
      renderStats(model);
      renderTree(model);
    } catch (e) {
      errorEl.style.display = 'block';
      errorEl.textContent = e.message;
      statsEl.innerHTML = '';
      treeEl.innerHTML = '';
    }
  }

  function renderStats(m) {
    const items = [
      ['Root', m.root?.id ?? '—'],
      ['Title', m.meta?.title ?? '—'],
      ['Roles', m.roles?.length ?? 0],
      ['Processes', m.processes?.length ?? 0],
      ['Provisions', m.provisions?.length ?? 0],
      ['Events', m.events?.length ?? 0],
      ['Gateways', m.gateways?.length ?? 0],
      ['Canvases', m.pages?.length ?? 0],
      ['Data Classes', m.dataclasses?.length ?? 0],
      ['References', m.references?.length ?? 0],
    ];
    statsEl.innerHTML = '<h3>Model Summary</h3><dl>' +
      items.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('') +
      '</dl>';
  }

  function renderTree(m) {
    const groups = [
      ['Roles', m.roles?.map(r => r.id)],
      ['Processes', m.processes?.map(p => `${p.id} (${p.name || ''})`)],
      ['Provisions', m.provisions?.map(p => p.id)],
      ['Events', m.events?.map(e => `${e.id} (${e.eventType})`)],
      ['References', m.references?.map(r => `${r.id}: ${r.clause || ''}`)],
    ].filter(([_, items]) => items && items.length > 0);

    treeEl.innerHTML = '<h3>Elements</h3>' +
      groups.map(([label, items]) =>
        `<div class="pg-tree-group"><span class="pg-tree-label">${label} (${items.length})</span><ul>${items.map(i => `<li>${i}</li>`).join('')}</ul></div>`
      ).join('');
  }

  codeEl.addEventListener('input', parse);
  parse();

  document.getElementById('pg-format')?.addEventListener('click', () => {
    try {
      const model = load(codeEl.value);
      codeEl.value = dump(model);
      parse();
    } catch {}
  });

  document.getElementById('pg-download')?.addEventListener('click', () => {
    const blob = new Blob([codeEl.value], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'model.prl';
    a.click();
  });
</script>

<style is:global>
  .pg-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 0;
    height: calc(100vh - 60px);
    max-width: none;
  }
  .pg-editor {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-rule);
  }
  .pg-editor-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-3);
  }
  .pg-btn {
    margin-left: auto;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text-2);
    font-size: 0.78rem;
    cursor: pointer;
  }
  .pg-btn:hover { background: var(--color-surface-2); }
  .pg-btn + .pg-btn { margin-left: 0; }
  .pg-code {
    flex: 1;
    border: none;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    resize: none;
    outline: none;
    background: var(--color-surface);
    color: var(--color-ink);
    tab-size: 2;
  }
  .pg-output {
    overflow-y: auto;
    padding: 1rem;
    background: var(--color-surface);
  }
  .pg-error {
    padding: 0.75rem;
    background: rgba(125, 42, 42, 0.1);
    border: 1px solid var(--color-burgundy);
    border-radius: 4px;
    color: var(--color-burgundy);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }
  .pg-stats h3, .pg-tree h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-3);
    margin-bottom: 0.5rem;
  }
  .pg-stats dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .pg-stats dt { color: var(--color-text-3); font-weight: 500; }
  .pg-stats dd { margin: 0; color: var(--color-ink); }
  .pg-tree-group { margin-bottom: 0.75rem; }
  .pg-tree-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-burgundy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .dark .pg-tree-label { color: var(--color-ochre); }
  .pg-tree ul {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0;
  }
  .pg-tree li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-2);
    padding: 0.15rem 0 0.15rem 0.75rem;
    border-left: 2px solid var(--color-rule);
    margin-left: 0.25rem;
  }
  @media (max-width: 768px) {
    .pg-layout { grid-template-columns: 1fr; height: auto; }
    .pg-output { border-top: 1px solid var(--color-rule); }
  }
</style>

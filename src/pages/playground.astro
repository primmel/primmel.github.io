---
import PageLayout from '../layouts/PageLayout.astro';
import PlaygroundApp from '../components/ui/PlaygroundApp.vue';

const sampleModel = `root HelloWorld

version "v1.0.0-dev1"

metadata {
  title "Hello World"
  schema "Primmel 0.1"
  namespace "HelloWorld"
}

role Greeter { name "Greeter" }

start_event Start { }
end_event Done { }

process Greet {
  name "Greet the world"
  actor Greeter
}

canvas Root {
  elements {
    Start { x 0 y 0 }
    Greet { x 0 y 100 }
    Done  { x 0 y 200 }
  }
  process_flow {
    E1 { from Start to Greet }
    E2 { from Greet to Done }
  }
}`;
---

<PageLayout title="Playground" description="Try Primmel in your browser — edit a model and see it parse live with a visual diagram." wide>
  <PlaygroundApp client:only="vue" code={sampleModel} />
</PageLayout>

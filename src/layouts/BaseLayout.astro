---
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/spline-sans-mono/400.css';
import '@fontsource/spline-sans-mono/500.css';
import '../styles/app.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import { buildSeoData, type SchemaType } from '../lib/structured-data';
import NavBarVue from '../components/ui/NavBar.vue';
import Footer from '../components/nav/Footer.astro';
import ScrollProgressVue from '../components/ui/ScrollProgress.vue';
import CodeEnhancementsVue from '../components/ui/CodeEnhancements.vue';

interface Props {
  title: string;
  description?: string;
  schema?: SchemaType;
}

const { title, description = SITE.description, schema = 'website' } = Astro.props;
const seo = buildSeoData({ title, description, url: Astro.url, schemaType: schema });
---

<!DOCTYPE html>
<html lang="en">
<head>
  <ClientRouter />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{seo.fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="/_astro/app.css" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1e3a8a" />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  <link rel="canonical" href={seo.canonicalUrl} />
  <meta property="og:type" content={schema === 'article' ? 'article' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:image" content={seo.ogImage} />
  <meta property="og:url" content={seo.canonicalUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={seo.ogImage} />
  {seo.jsonLdScripts.map((s) => (
    <script is:inline set:html={JSON.stringify(s)} type="application/ld+json"></script>
  ))}
  <script is:inline>
    const t = localStorage.getItem('theme') ?? 'auto';
    const d = t === 'dark' || (t === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', d);
  </script>
  <script is:inline>
    document.addEventListener('astro:before-swap', (ev) => {
      if (document.documentElement.classList.contains('dark')) {
        ev.newDocument.documentElement.classList.add('dark');
      }
    });
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <ScrollProgressVue client:load />
  <CodeEnhancementsVue client:idle />
  <NavBarVue
    client:load
    navItems={[...SITE.nav]}
    siteTitle={SITE.title}
    githubUrl={SITE.github}
  />
  <slot />
  <Footer />
<script is:inline>
  document.addEventListener('astro:after-swap', () => {
    document.body.classList.remove('sidebar-open');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.body.classList.remove('sidebar-open');
  });
</script>
</body>
</html>

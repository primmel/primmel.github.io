---
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/spline-sans-mono/400.css';
import '@fontsource/spline-sans-mono/500.css';
import '../styles/app.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import NavBar from '../components/nav/NavBar.astro';
import Footer from '../components/nav/Footer.astro';
import ScrollProgressVue from '../components/ui/ScrollProgress.vue';
import CodeEnhancementsVue from '../components/ui/CodeEnhancements.vue';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const pagePath = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '').replace(/\//g, '-');
const ogImage = pagePath ? `/og/${pagePath}.png` : '/og/index.png';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <ClientRouter />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1e3a8a" />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <script is:inline set:html={`{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "${title}",
    "url": "${SITE.url}"
  }`} type="application/ld+json" />
  <script is:inline>
    const t = localStorage.getItem('theme') ?? 'auto';
    const d = t === 'dark' || (t === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', d);
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <ScrollProgressVue client:load />
  <CodeEnhancementsVue client:idle />
  <NavBar />
  <slot />
  <Footer />
<script is:inline>
  function toggleSidebar() {
    document.body.classList.toggle('sidebar-open');
  }
  function initSidebar() {
    const hamburger = document.getElementById('hamburger');
    if (!hamburger) return;
    if (!document.querySelector('.sidebar')) {
      hamburger.style.display = 'none';
      return;
    }
    hamburger.addEventListener('click', toggleSidebar);
  }
  initSidebar();
  document.addEventListener('astro:after-swap', initSidebar);
  document.addEventListener('click', (e) => {
    if (e.target.classList?.contains('sidebar-backdrop')) toggleSidebar();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.body.classList.remove('sidebar-open');
  });
  document.addEventListener('astro:after-swap', () => {
    document.body.classList.remove('sidebar-open');
  });
</script>
</body>
</html>
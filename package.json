{
  "name": "primmel.github.io",
  "version": "2.0.0",
  "description": "Primmel — executable standards modelling for SMART standards",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/generate-og.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/validate-links.mjs",
    "check:a11y": "node scripts/accessibility-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "npx playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vue": "^7.0.1",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "@primmel/primmel": "^1.3.1",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "astro": "^7.0.7",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
